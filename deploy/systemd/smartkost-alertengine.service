[Unit]
Description=Smart Kost - Alert Engine (worker anomali + notifier Telegram)
After=network-online.target smartkost-ingest.service influxdb.service
Wants=network-online.target
Requires=smartkost-ingest.service

[Service]
Type=simple
User=supriadi
WorkingDirectory=/home/supriadi/Dev/smartkost
EnvironmentFile=/home/supriadi/Dev/smartkost/.env
ExecStart=/home/supriadi/Dev/smartkost/bin/alertengine
Restart=on-failure
RestartSec=5
MemoryMax=256M

NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/supriadi/Dev/smartkost/data

[Install]
WantedBy=multi-user.target
