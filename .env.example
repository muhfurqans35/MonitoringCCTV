# --- InfluxDB ---
INFLUX_USER=admin
INFLUX_PASSWORD=change_me_strong_password
INFLUX_ORG=smartkost
INFLUX_BUCKET=telemetry
INFLUX_TOKEN=change_me_generate_a_long_random_token

# --- Login dashboard (sesi cookie HttpOnly, lihat docs/SECURITY.md) ---
# Akun dibuat dengan: bin/api user add admin owner
# Keluar otomatis bila tidak dipakai selama ini (jam), dan batas umur sesi (hari)
SESSION_IDLE_HOURS=72
SESSION_MAX_DAYS=14
# auto = cookie Secure bila diakses lewat HTTPS (Cloudflare Tunnel); true/false untuk memaksa
COOKIE_SECURE=auto
# api hanya dari localhost (lewat nginx). Docker: 0.0.0.0
API_BIND=127.0.0.1
# JWT_SECRET tidak dipakai lagi untuk login (boleh dibiarkan)
JWT_SECRET=change_me_generate_a_long_random_secret

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=isi_token_botfather_disini
TELEGRAM_OWNER_CHAT_ID=isi_chat_id_pemilik_kost

# --- Doorbell (bel pintu interaktif) ---
# Token bersama antara hub dan node ESP32 (DEVICE_TOKEN di firmware). Buat acak: openssl rand -hex 16
DOORBELL_CAMERA_TOKEN=change_me_random_device_token
DOORBELL_GRPC_PORT=9091
DOORBELL_GRPC_ADDR=http://doorbell-service:9091

# --- MQTT ---
MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883
# Wajib diisi setelah Mosquitto memakai password (docs/SECURITY.md)
MQTT_USERNAME=smartkost
MQTT_PASSWORD=

# --- SQLite (format URL sqlx) ---
SQLITE_PATH=sqlite:///data/smartkost.db

# --- Ports ---
API_PORT=8080
GRPC_PORT=9090
INGEST_GRPC_ADDR=http://ingest-service:9090
